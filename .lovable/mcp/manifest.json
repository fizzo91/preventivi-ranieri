{
  "version": 1,
  "sdk_version": "0.23.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ahyazehjcodmvyddchuk.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "preventivi-ranieri-mcp",
      "version": "0.4.0",
      "title": "Preventivi Ranieri"
    },
    "tools": [
      {
        "name": "list_quotes",
        "title": "Elenca preventivi",
        "description": "Elenca i preventivi dell'utente autenticato, dal più recente. Filtri opzionali per cliente e limite.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Numero massimo di risultati (default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "client_name": {
              "description": "Filtro parziale case-insensitive sul nome cliente.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_quote",
        "title": "Dettaglio preventivo",
        "description": "Restituisce il preventivo completo (sezioni, voci, totali, note) per l'id indicato.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "UUID del preventivo."
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_clients",
        "title": "Elenca clienti",
        "description": "Elenca i clienti dell'utente autenticato. Ricerca opzionale su nome/azienda/email.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "search": {
              "description": "Ricerca parziale case-insensitive su nome, azienda o email.",
              "type": "string"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_products",
        "title": "Elenca prodotti",
        "description": "Elenca i prodotti a listino (DT) dell'utente. Ricerca opzionale su nome/codice/categoria.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "search": {
              "description": "Ricerca parziale case-insensitive su nome, codice o categoria.",
              "type": "string"
            },
            "include_archived": {
              "description": "Includere prodotti archiviati (default false).",
              "type": "boolean"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "calculate_cost_draft",
        "title": "Calcola bozza costo",
        "description": "Calcola in modo deterministico il costo di una sezione. Non salva e non modifica alcun preventivo.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "finished_sqm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "second_cut_sqm": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "slab_sqm": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "finish": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "components": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string"
                  },
                  "quantity": {
                    "type": "number",
                    "minimum": 0
                  },
                  "unit_price": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "code",
                  "description",
                  "quantity",
                  "unit_price"
                ]
              }
            },
            "engobbio": {
              "type": "number",
              "minimum": 0
            },
            "finish_cost": {
              "type": "number",
              "minimum": 0
            },
            "risk_percent": {
              "type": "number",
              "minimum": 0
            },
            "average_cost_per_sqm": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "name",
            "finished_sqm",
            "components",
            "engobbio",
            "finish_cost",
            "risk_percent"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "import_zoho_project_draft",
        "title": "Importa progetto Zoho in bozza",
        "description": "Legge Deal, quotation, note e allegati da Zoho e genera un dossier tecnico. Non modifica Zoho o WorkDrive.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "deal_id": {
              "type": "string",
              "pattern": "^\\d{10,25}$",
              "description": "ID numerico del Deal Zoho"
            }
          },
          "required": [
            "deal_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "create_quote",
        "title": "Crea preventivo",
        "description": "Crea e salva un nuovo preventivo con sezioni e voci. Usa prima list_products per trovare i product_id; i prezzi sono presi dal listino DT.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "client_name": {
              "type": "string",
              "minLength": 1
            },
            "client_company": {
              "type": "string"
            },
            "client_email": {
              "type": "string"
            },
            "client_phone": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            },
            "sections": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "description": "Descrizione tecnica della sezione.",
                    "type": "string"
                  },
                  "quantity": {
                    "description": "Moltiplicatore sezione (default 1).",
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "mq_totali": {
                    "type": "number",
                    "minimum": 0
                  },
                  "items": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "product_id": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                          "description": "UUID del prodotto ottenuto da list_products. Il prezzo DT viene letto dal listino."
                        },
                        "quantity": {
                          "type": "number",
                          "minimum": 0
                        },
                        "description": {
                          "description": "Nota opzionale sulla voce.",
                          "type": "string"
                        },
                        "risk_percent": {
                          "description": "Rischio % applicato a questa singola voce.",
                          "type": "number",
                          "minimum": 0,
                          "maximum": 100
                        }
                      },
                      "required": [
                        "product_id",
                        "quantity"
                      ]
                    }
                  },
                  "section_risk_percent": {
                    "description": "Rischio % sul totale voci della sezione.",
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "engobbio_base": {
                    "description": "Costo engobbio € (base).",
                    "type": "number",
                    "minimum": 0
                  },
                  "engobbio_risk_percent": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "finitura": {
                    "description": "Costo finitura/smaltatura €.",
                    "type": "number",
                    "minimum": 0
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "name",
                  "items"
                ]
              }
            }
          },
          "required": [
            "client_name",
            "sections"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
