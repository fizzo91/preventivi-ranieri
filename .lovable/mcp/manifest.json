{
  "version": 1,
  "sdk_version": "0.23.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ahyazehjcodmvyddchuk.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "preventivi-ranieri-mcp",
      "version": "0.1.0",
      "title": "Preventivi Ranieri"
    },
    "tools": [
      {
        "name": "list_quotes",
        "title": "Elenca preventivi",
        "description": "Elenca i preventivi dell'utente autenticato, dal più recente. Filtri opzionali per cliente e limite.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Numero massimo di risultati (default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "client_name": {
              "description": "Filtro parziale case-insensitive sul nome cliente.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_quote",
        "title": "Dettaglio preventivo",
        "description": "Restituisce il preventivo completo (sezioni, voci, totali, note) per l'id indicato.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "UUID del preventivo."
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_clients",
        "title": "Elenca clienti",
        "description": "Elenca i clienti dell'utente autenticato. Ricerca opzionale su nome/azienda/email.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "search": {
              "description": "Ricerca parziale case-insensitive su nome, azienda o email.",
              "type": "string"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_products",
        "title": "Elenca prodotti",
        "description": "Elenca i prodotti a listino (DT) dell'utente. Ricerca opzionale su nome/codice/categoria.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "search": {
              "description": "Ricerca parziale case-insensitive su nome, codice o categoria.",
              "type": "string"
            },
            "include_archived": {
              "description": "Includere prodotti archiviati (default false).",
              "type": "boolean"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
